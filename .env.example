# Application
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_agent

# LLM provider (supported: openai, gemini, groq)
# Leave model and key empty to run case-management endpoints without live analysis.
# Set both locally to enable POST /api/cases/:id/analyze. Never commit a real key.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=

# Reliability and logging
LOG_LEVEL=info
MAX_LLM_RETRIES=1
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.75

# Optional live-evaluation pacing override (Groq defaults to 9000; other providers to 0)
EVAL_REQUEST_INTERVAL_MS=9000
