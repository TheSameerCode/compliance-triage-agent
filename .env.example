# Application
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_agent

# LLM provider (replace placeholders locally; never commit a real key)
LLM_PROVIDER=openai
LLM_MODEL=<model-name>
LLM_API_KEY=<set-locally-do-not-commit>

# Reliability and logging
LOG_LEVEL=info
MAX_LLM_RETRIES=1
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.75
